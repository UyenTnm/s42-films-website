# --- Private access (email + one-time code) ---

# Secret used to sign codes and sessions. Required in production.
# Generate one with:  openssl rand -base64 32
SITE_ACCESS_SECRET=

# Resend (https://resend.com): only sends the access code email.
# A "Sending access" API key limited to the s42films.com domain is enough.
RESEND_API_KEY=

# Sender on the verified domain, e.g.  S•42 Films <access@s42films.com>
RESEND_FROM=

# monday.com: verified visitors (email, first name, last name, company) are
# saved as items on this board. Leave empty to skip saving.
# Token: monday.com > profile picture > Developers > My access tokens.
MONDAY_API_TOKEN=
# Board ID: the number in the board URL (monday.com/boards/<ID>).
MONDAY_BOARD_ID=
