# --- Private access (email + one-time code) ---

# Secret used to sign codes and sessions. Required in production.
# Generate one with:  openssl rand -base64 32
SITE_ACCESS_SECRET=

# Resend (https://resend.com): sends the access code and stores visitor emails.
# Use an API key limited to the s42films.com domain.
RESEND_API_KEY=

# Sender on the verified domain, e.g.  S•42 Films <access@s42films.com>
RESEND_FROM=

# Optional: Resend segment ID that verified emails are added to.
RESEND_SEGMENT_ID=
